<h2>Random Number Generator with Addition</h2>
<p>This application generates a random number between 1 and 100. You can optionally enter a number in the input field below, and it will be added to the random number when you press the button.</p>

<div>
  <label for="inputNumber">Enter a number (optional): </label>
  <input type="number" id="inputNumber" (input)="updateInputValue($event)">
</div>

<button (click)="generateAndAdd()">Generate and Add</button>

<div *ngIf="randomNumber !== null">
  <p>Random Number: {{ randomNumber }}</p>
  <p *ngIf="inputValue !== null">Input Number: {{ inputValue }}</p>
  <p>Result: {{ randomNumber }} <span *ngIf="inputValue !== null">+ {{ inputValue }}</span> = {{ result }}</p>
</div>
